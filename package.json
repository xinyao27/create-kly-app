{
  "name": "create-kly-app",
  "version": "0.0.0",
  "description": "Create kly applications with a single command",
  "keywords": [
    "ai",
    "cli",
    "kly",
    "scaffolding",
    "template"
  ],
  "homepage": "https://github.com/xinyao27/create-kly-app#readme",
  "bugs": {
    "url": "https://github.com/xinyao27/create-kly-app/issues"
  },
  "license": "MIT",
  "author": {
    "name": "xinyao27",
    "email": "hi@xinyao.me"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xinyao27/create-kly-app.git"
  },
  "files": [
    "dist/*",
    "templates/*"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "bun run typecheck && oxlint && oxfmt",
    "prepublishOnly": "nr build",
    "release": "release-it",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "up": "taze major -I",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "giget": "^2.0.0",
    "kly": "^0.3.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@antfu/ni": "^28.0.0",
    "@release-it/conventional-changelog": "^10.0.4",
    "@types/bun": "^1.3.5",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.21.0",
    "oxlint": "^1.36.0",
    "publint": "^0.3.16",
    "release-it": "^19.2.2",
    "simple-git-hooks": "^2.13.1",
    "taze": "^19.9.2",
    "tsdown": "^0.18.4",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "oxlint && oxfmt"
  }
}
